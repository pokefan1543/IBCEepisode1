[input_devices]

pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_2="Enemy"
3d_physics/layer_3="World"

[physics]

3d/physics_engine="GodotPhysics"
common/enable_pause_aware_picking=true

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
quality/directional_shadow/size=768
lights_and_shadows/shadow_atlas/size=768
quality/spatial_partitioning/render_tree_balance=1.0
quality/subsurface_scattering/quality=2
quality/voxel_cone_tracing/high_quality=true
quality/reflections/atlas_size=800
