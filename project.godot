; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Inbetween Chaos and Equilibrium"
config/description="A game where you play as various characters, trying to defeat a almost insurmountable threat of cosmic proportions that plays like Quake mixed with Mega Man X, Doom, and Prodeus"
config/version="0.0.1"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.3")
boot_splash/image="res://Assets/Logo and Start Sceen/IBCE SPLASH SCREEN.png"
config/icon="res://Assets/Logo and Start Sceen/IBCE LOGO.png"
config/windows_native_icon="res://IBCE LOGO.ico"
config/build=1

[autoload]

Globals="*res://scripts/globals.gd"
KeyPersistence="res://scenes/KeyPersistence.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"unit_test_character": "res://addons/dialogic/Editor/TimelineEditor/dialogic-main/Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={}
glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style="Default"
variables={}

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/always_on_top=true
window/size/window_width_override=640
window/size/window_height_override=480
window/stretch/mode="viewport"
window/vsync/vsync_mode=false

[editor]

version_control_autoload_on_startup=true
version_control_plugin_name="GitAPI"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global]

full=false
default=false
collision=false
export=false
safe=false
vsync=false

