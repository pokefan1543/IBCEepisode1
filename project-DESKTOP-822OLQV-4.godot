environment/defaults/default_environment="res://default_env.tres"
quality/directional_shadow/size=768
lights_and_shadows/shadow_atlas/size=768
quality/spatial_partitioning/render_tree_balance=1.0
quality/subsurface_scattering/quality=2
quality/voxel_cone_tracing/high_quality=true
quality/reflections/atlas_size=800
